# [쿠팡 파트너스 API 자격 증명]
COUPANG_ACCESS_KEY=your_coupang_access_key
COUPANG_SECRET_KEY=your_coupang_secret_key

# [텔레그램 봇 자격 증명]
# @BotFather 에게서 발급받은 토큰 (예: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 송출용 채널 ID (공개 채널의 경우 @채널아이디 또는 -100으로 시작하는 숫자 ID)
TELEGRAM_PUBLIC_CHANNEL_ID=@your_public_channel

# 내 전용 대시보드 채널/채팅 ID (내 개인 Telegram ID 또는 비공개 채널 ID)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id
